# Azure Storage connection string — use Azurite locally
# Start Azurite with: npx azurite --silent --location .azurite
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Table name prefix: "preview" → uses preview_ratings / preview_comments tables
# Leave unset or set to "production" for production tables
TABLE_ENV=local

# Faro API key (optional for local dev)
# FARO_API_KEY=

# Build version (set automatically by CI)
# PUBLIC_BUILD_VERSION=
