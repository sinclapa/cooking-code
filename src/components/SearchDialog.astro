---
---

<div id="search-overlay" class="search-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Search">
  <div class="search-modal">
    <div class="search-input-row">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        type="search"
        id="search-input"
        class="search-input"
        placeholder="Search articles and posts…"
        autocomplete="off"
        spellcheck="false"
        aria-autocomplete="list"
        aria-controls="search-results"
      />
      <kbd class="search-esc-hint">Esc</kbd>
    </div>
    <div id="search-results" class="search-results" role="listbox" aria-label="Search results"></div>
    <p id="search-empty" class="search-empty" hidden></p>
    <p id="search-hint" class="search-hint" hidden>↑↓ navigate &middot; Enter open &middot; Esc close</p>
  </div>
</div>

<script>
  type SearchItem = {
    title: string;
    description: string;
    tags: string[];
    type: 'article' | 'blog';
    difficulty: string | null;
    url: string;
  };

  const overlay = document.getElementById('search-overlay')!;
  const inputEl = document.getElementById('search-input') as HTMLInputElement;
  const resultsEl = document.getElementById('search-results')!;
  const emptyEl = document.getElementById('search-empty')!;
  const hintEl = document.getElementById('search-hint')!;

  let searchData: SearchItem[] = [];
  let activeIndex = -1;

  async function loadIndex() {
    if (searchData.length) return;
    const res = await fetch('/search-index.json');
    searchData = await res.json();
  }

  function matchesQuery(item: SearchItem, q: string) {
    return (
      item.title.toLowerCase().includes(q) ||
      item.description.toLowerCase().includes(q) ||
      item.tags.some((t) => t.toLowerCase().includes(q))
    );
  }

  function openDialog() {
    overlay.setAttribute('aria-hidden', 'false');
    overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    inputEl.focus();
    loadIndex();
  }

  function closeDialog() {
    overlay.setAttribute('aria-hidden', 'true');
    overlay.classList.remove('is-open');
    document.body.style.overflow = '';
    inputEl.value = '';
    resultsEl.innerHTML = '';
    emptyEl.hidden = true;
    hintEl.hidden = true;
    activeIndex = -1;
  }

  function escapeHtml(str: string) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function renderResults(query: string) {
    if (!query.trim()) {
      resultsEl.innerHTML = '';
      emptyEl.hidden = true;
      hintEl.hidden = true;
      activeIndex = -1;
      return;
    }

    const q = query.toLowerCase().trim();
    const results = searchData.filter((item) => matchesQuery(item, q));

    if (results.length === 0) {
      resultsEl.innerHTML = '';
      emptyEl.textContent = `No results for "${query}"`;
      emptyEl.hidden = false;
      hintEl.hidden = true;
      activeIndex = -1;
      return;
    }

    emptyEl.hidden = true;
    hintEl.hidden = false;
    activeIndex = -1;

    let html = '';
    results.forEach((item, i) => {
      const label = item.type === 'blog' ? 'Blog' : 'Article';
      html += `<a href="${escapeHtml(item.url)}" class="search-result" data-idx="${i}" role="option">
        <span class="result-type result-type--${item.type}">${label}</span>
        <span class="result-title">${escapeHtml(item.title)}</span>
        <span class="result-arrow" aria-hidden="true">→</span>
      </a>`;
    });
    resultsEl.innerHTML = html;
  }

  function getResultItems() {
    return Array.from(resultsEl.querySelectorAll<HTMLElement>('.search-result'));
  }

  function setActive(index: number) {
    const items = getResultItems();
    if (items.length === 0) return;
    const clamped = Math.max(0, Math.min(index, items.length - 1));
    items.forEach((el, i) => el.classList.toggle('is-active', i === clamped));
    items[clamped]?.scrollIntoView({ block: 'nearest' });
    activeIndex = clamped;
  }

  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeDialog();
  });

  inputEl.addEventListener('input', () => renderResults(inputEl.value));

  document.addEventListener('keydown', (e) => {
    const tag = (document.activeElement as HTMLElement)?.tagName;
    const inInput = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';
    const isOpen = overlay.classList.contains('is-open');

    if (e.key === '/' && !inInput && !isOpen) {
      e.preventDefault();
      openDialog();
      return;
    }

    if (e.key === 'k' && (e.ctrlKey || e.metaKey)) {
      e.preventDefault();
      isOpen ? closeDialog() : openDialog();
      return;
    }

    if (!isOpen) return;

    const items = getResultItems();

    if (e.key === 'Escape') {
      closeDialog();
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      setActive(activeIndex + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setActive(activeIndex <= 0 ? 0 : activeIndex - 1);
    } else if (e.key === 'Enter' && items.length > 0) {
      const target = activeIndex >= 0 ? items[activeIndex] : items[0];
      (target as HTMLAnchorElement)?.click();
    }
  });

  document.addEventListener('opensearch', () => openDialog());
</script>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.72);
    z-index: 500;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 5rem 1rem 1rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .search-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .search-modal {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    width: 100%;
    max-width: 600px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    transform: translateY(-8px);
    transition: transform 0.15s ease;
  }

  .search-overlay.is-open .search-modal {
    transform: translateY(0);
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .search-icon {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-text);
    min-width: 0;
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .search-input::-webkit-search-decoration,
  .search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .search-esc-hint {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.15em 0.45em;
    font-family: var(--font-sans);
    flex-shrink: 0;
  }

  .search-results {
    max-height: 60vh;
    overflow-y: auto;
    padding: 0.375rem;
  }

  /* Result elements are injected via innerHTML so Astro's scoping hash is absent — use :global() */
  :global(.search-result) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-text);
    transition: background 0.1s, color 0.1s;
  }

  :global(.search-result:hover),
  :global(.search-result.is-active) {
    background: var(--color-surface-raised);
    color: var(--color-text);
  }

  :global(.result-type) {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2em 0.6em;
    border-radius: 999px;
    border: 1px solid currentColor;
    flex-shrink: 0;
    line-height: 1.6;
  }

  :global(.result-type--blog) {
    color: var(--color-accent-blog);
  }

  :global(.result-type--article) {
    color: var(--color-accent-article);
  }

  :global(.result-title) {
    flex: 1;
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.result-arrow) {
    color: var(--color-text-muted);
    font-size: 1rem;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.1s, transform 0.1s;
    flex-shrink: 0;
  }

  :global(.search-result:hover .result-arrow),
  :global(.search-result.is-active .result-arrow) {
    opacity: 1;
    transform: translateX(0);
  }

  .search-empty {
    padding: 2rem 1rem;
    text-align: center;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .search-hint {
    padding: 0.5rem 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    text-align: center;
    margin: 0;
  }

  @media (max-width: 640px) {
    .search-overlay {
      padding: 3.5rem 0.5rem 0.5rem;
      align-items: flex-start;
    }
  }
</style>
