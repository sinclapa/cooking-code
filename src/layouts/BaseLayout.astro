---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = 'Cooking Code — articles and blog posts for developers.', image } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Apply saved theme before first paint to prevent flash -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = saved || (prefersDark ? 'dark' : 'light');
      })();
    </script>
    <link rel="icon" type="image/x-icon" href="/branding/cc-logo-white-simple.ico" />
    <link rel="icon" type="image/svg+xml" href="/branding/cc-logo-white-simple.svg" />
    <link rel="apple-touch-icon" href="/branding/cc-logo-white-simple.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | Cooking Code</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Cooking Code`} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.url)} />}

    <!-- Fonts -->
    <script>import '../faro';</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fira+Code:wght@400;500&display=swap" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <script is:inline>
      document.querySelectorAll('pre').forEach((pre) => {
        if (pre.classList.contains('mermaid')) return;
        const btn = document.createElement('button');
        btn.className = 'copy-code-btn';
        btn.textContent = 'Copy';
        btn.addEventListener('click', async () => {
          const code = pre.querySelector('code');
          await navigator.clipboard.writeText(code ? code.innerText : pre.innerText);
          btn.textContent = 'Copied!';
          btn.classList.add('copied');
          setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2000);
        });
        pre.appendChild(btn);
      });
    </script>
    <script>
      const diagrams = document.querySelectorAll('pre.mermaid');
      if (diagrams.length > 0) {
        const { default: mermaid } = await import('mermaid');

        // Store original diagram text before first render so we can re-render on theme change
        diagrams.forEach((pre) => { pre.dataset.diagram = pre.textContent ?? ''; });

        function mermaidThemeConfig(theme) {
          return theme === 'light'
            ? { theme: 'default', themeVariables: {} }
            : {
                theme: 'dark',
                themeVariables: {
                  edgeLabelBackground: '#0f172a',
                  lineColor: '#94a3b8',
                  clusterBkg: '#1e293b',
                  clusterBorder: '#334155',
                  titleColor: '#f1f5f9',
                },
              };
        }

        async function renderDiagrams(theme) {
          mermaid.initialize({ startOnLoad: false, ...mermaidThemeConfig(theme) });
          diagrams.forEach((pre) => { pre.textContent = pre.dataset.diagram ?? ''; });
          await mermaid.run({ nodes: diagrams });
        }

        const initialTheme = document.documentElement.dataset.theme ?? 'dark';
        await renderDiagrams(initialTheme);

        document.documentElement.addEventListener('themechange', (e) => {
          renderDiagrams(e.detail.theme);
        });

        const expandIcon = `<svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M0 0H4.5V1.5H1.5V4.5H0ZM7.5 0H12V4.5H10.5V1.5H7.5ZM0 7.5H1.5V10.5H4.5V12H0ZM10.5 7.5H12V12H7.5V10.5H10.5Z"/></svg>`;

        function openDiagramModal(pre) {
          const svg = pre.querySelector('svg');
          if (!svg) return;

          const overlay = document.createElement('div');
          overlay.className = 'mermaid-modal';
          overlay.setAttribute('role', 'dialog');
          overlay.setAttribute('aria-modal', 'true');

          const content = document.createElement('div');
          content.className = 'mermaid-modal-content';

          const clonedSvg = svg.cloneNode(true);
          clonedSvg.removeAttribute('width');
          clonedSvg.removeAttribute('height');
          clonedSvg.style.cssText = '';
          content.appendChild(clonedSvg);

          const closeBtn = document.createElement('button');
          closeBtn.className = 'mermaid-modal-close';
          closeBtn.setAttribute('aria-label', 'Close diagram');
          closeBtn.textContent = '✕';

          overlay.appendChild(content);
          overlay.appendChild(closeBtn);
          document.body.appendChild(overlay);
          document.body.style.overflow = 'hidden';

          requestAnimationFrame(() => overlay.classList.add('is-open'));
          closeBtn.focus();

          const close = () => {
            overlay.classList.remove('is-open');
            overlay.addEventListener('transitionend', () => {
              overlay.remove();
              document.body.style.overflow = '';
            }, { once: true });
            document.removeEventListener('keydown', onKey);
          };

          const onKey = (e) => { if (e.key === 'Escape') close(); };
          overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
          closeBtn.addEventListener('click', close);
          document.addEventListener('keydown', onKey);
        }

        diagrams.forEach((pre) => {
          const btn = document.createElement('button');
          btn.className = 'mermaid-expand-btn';
          btn.title = 'View full size';
          btn.innerHTML = expandIcon;
          btn.addEventListener('click', () => openDiagramModal(pre));
          pre.appendChild(btn);
        });
      }
    </script>
  </body>
</html>
